#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

PROG=/usr/bin/tapx-panel
CONTROL_SOCKET=/var/run/tapx/runtime-control.sock

start_service() {
	local enabled initialized listen_interface db_path core_autostart
	local respawn_threshold respawn_timeout respawn_retry

	config_load tapx
	config_get_bool enabled panel enabled 0
	[ "$enabled" = "1" ] || {
		echo "tapx-panel: disabled in /etc/config/tapx"
		return 0
	}

	config_get_bool initialized panel initialized 0
	config_get listen_interface panel listen_interface ''
	config_get db_path panel db_path '/etc/tapx/tapx.db'
	config_get respawn_threshold panel respawn_threshold 3600
	config_get respawn_timeout panel respawn_timeout 5
	config_get respawn_retry panel respawn_retry 5
	config_get_bool core_autostart core autostart 0

	[ -x "$PROG" ] || {
		echo "tapx-panel: missing executable $PROG" >&2
		return 1
	}
	[ "$initialized" = "1" ] || {
		echo "tapx-panel: initial panel setup is incomplete" >&2
		return 1
	}
	if [ -n "$listen_interface" ] && [ ! -e "/sys/class/net/$listen_interface" ]; then
		echo "tapx-panel: listen interface does not exist: $listen_interface" >&2
		return 1
	fi
	[ -s "$db_path" ] || {
		echo "tapx-panel: initialized database is missing: $db_path" >&2
		return 1
	}
	# A standalone core may be carrying the runtime while TapX-UI is down.
	# Stop it cleanly before the panel takes ownership, otherwise its external
	# Xray child can overlap with the panel-managed instance.
	if pidof tapx-core >/dev/null 2>&1; then
		/etc/init.d/tapx stop
	fi
	mkdir -p "${db_path%/*}"
	mkdir -p "${CONTROL_SOCKET%/*}"

	procd_open_instance panel
	procd_set_param command "$PROG" \
		-db "$db_path" \
		-listen-interface "$listen_interface" \
		-runtime-control-socket "$CONTROL_SOCKET"
	procd_set_param env \
		TAPX_RUNTIME_AUTOSTART="$core_autostart" \
		TAPX_RUNTIME_CONTROL_SOCKET="$CONTROL_SOCKET"
	procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
	# Runtime shutdown waits for external Xray before falling back to SIGKILL.
	procd_set_param term_timeout 15
	procd_set_param file /etc/config/tapx "$db_path"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger tapx
}
