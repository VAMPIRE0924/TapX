#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/tapx-core
PANEL=/usr/bin/tapx-panel
DEFAULT_CONFIG=/etc/tapx/runtime.json
DEFAULT_DB=/etc/tapx/tapx.db
CONTROL_SOCKET=/var/run/tapx/runtime-control.sock

extra_command "runtime_status" "Show the TapX runtime state managed by TapX-UI"
extra_command "runtime_start" "Start the TapX runtime without restarting TapX-UI"
extra_command "runtime_restart" "Restart the TapX runtime without restarting TapX-UI"
extra_command "runtime_stop" "Stop the TapX runtime without stopping TapX-UI"

panel_control() {
	[ -S "$CONTROL_SOCKET" ] || return 1
	"$PANEL" -runtime-control-socket "$CONTROL_SOCKET" -runtime-action "$1"
}

runtime_status() {
	if panel_control status; then
		return 0
	fi
	if pidof tapx-core >/dev/null 2>&1; then
		printf '%s\n' '{"running":true,"mode":"standalone"}'
	else
		printf '%s\n' '{"running":false,"mode":"standalone"}'
	fi
}

runtime_start() {
	if [ -S "$CONTROL_SOCKET" ]; then
		panel_control start
		return
	fi
	/etc/init.d/tapx start
}

runtime_restart() {
	if [ -S "$CONTROL_SOCKET" ]; then
		panel_control restart
		return
	fi
	/etc/init.d/tapx restart
}

runtime_stop() {
	if [ -S "$CONTROL_SOCKET" ]; then
		panel_control stop
		return
	fi
	/etc/init.d/tapx stop
}

start_service() {
	local enabled panel_enabled panel_initialized config_path db_path
	local respawn_threshold respawn_timeout respawn_retry

	config_load tapx
	config_get_bool panel_enabled panel enabled 0
	config_get_bool panel_initialized panel initialized 0
	config_get_bool enabled core enabled 0
	[ "$enabled" = "1" ] || {
		echo "tapx: disabled in /etc/config/tapx"
		return 0
	}
	[ "$panel_enabled" = "1" ] && [ "$panel_initialized" = "1" ] && [ -S "$CONTROL_SOCKET" ] && {
		panel_control start
		return
	}

	config_get config_path core config_path "$DEFAULT_CONFIG"
	config_get db_path panel db_path "$DEFAULT_DB"
	config_get respawn_threshold core respawn_threshold 3600
	config_get respawn_timeout core respawn_timeout 5
	config_get respawn_retry core respawn_retry 5

	[ -x "$PROG" ] || {
		echo "tapx: missing executable $PROG" >&2
		return 1
	}
	if [ -x "$PANEL" ] && [ -s "$db_path" ]; then
		"$PANEL" -db "$db_path" -export-runtime-config "$config_path" || {
			echo "tapx: failed to generate runtime config from database" >&2
			return 1
		}
	fi
	[ -s "$config_path" ] || {
		echo "tapx: missing runtime config $config_path" >&2
		return 1
	}

	procd_open_instance core
	procd_set_param command "$PROG" -config "$config_path"
	procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
	# The runtime may need up to five seconds to stop an external Xray
	# process. Keep the Go parent alive long enough to finish that cleanup.
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger tapx
}
